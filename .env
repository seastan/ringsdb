# The environment variables of the application (formerly app/config/parameters.yml), with
# their default values. Committed: no real credentials or secrets here. Loaded by
# config/bootstrap.php, then overridden by, in this order (each file wins over the previous ones):
#   .env.local            the values of this machine (on a server: the real ones, APP_ENV=prod
#                         included), not committed, not loaded in the test environment
#   .env.<APP_ENV>        the values of an environment, committed (.env.dev: the local Docker
#                         stack, .env.test: the tests)
#   .env.<APP_ENV>.local  the values of this machine for that environment, not committed
# A real environment variable (web server, shell, phpunit.xml) wins over all the files.
# An empty value is an empty string, not null.

# The environment: dev, prod or test (set by phpunit.xml for the tests)
APP_ENV=dev

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=symfony
DATABASE_USER=root
DATABASE_PASSWORD=

# Mailer
MAILER_TRANSPORT=smtp
MAILER_ENCRYPTION=ssl
MAILER_AUTH_MODE=login
MAILER_HOST=127.0.0.1
MAILER_USER=
MAILER_PASSWORD=

# A secret key that's used to generate certain security-related tokens
SECRET=ThisTokenIsNotSoSecretChangeIt

# Cache-Control max-age of the public pages and API, in seconds
CACHE_EXPIRATION=600

# Email sender
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=

# Branding
GAME_NAME=
PUBLISHER_NAME=

# DragnCards integration: room name in the plugin URL
DRAGNCARDS_ROOM=ringsdb

# true to add <meta name="robots" content="noindex"> (use on non-production sites)
NOINDEX=false
