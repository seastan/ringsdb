{
    "name": "sydtrack/ringsdb",
    "description": "The Lord of the Rings LCG deckbuilder",
    "license": "proprietary",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "beberlei/doctrineextensions": "^1.3.0",
        "doctrine/common": "^3.0.0",
        "doctrine/dbal": "^3.7.0",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-fixtures-bundle": "^3.5.0",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.4",
        "doctrine/persistence": "^3.1",
        "erusev/parsedown": "^1.6",
        "ezyang/htmlpurifier": "^4.6",
        "friendsofsymfony/jsrouting-bundle": "^3.6.0",
        "gedmo/doctrine-extensions": "^3.22.2",
        "nelmio/api-doc-bundle": "^4.38",
        "ocramius/proxy-manager": "~2.2.0",
        "phpoffice/phpspreadsheet": "^5.10.0",
        "scssphp/scssphp": "^1.13",
        "symfony/asset": "*",
        "symfony/cache": "*",
        "symfony/clock": "6.4.*",
        "symfony/config": "*",
        "symfony/console": "*",
        "symfony/css-selector": "*",
        "symfony/dependency-injection": "*",
        "symfony/doctrine-bridge": "*",
        "symfony/dom-crawler": "*",
        "symfony/dotenv": "*",
        "symfony/event-dispatcher": "*",
        "symfony/filesystem": "*",
        "symfony/finder": "*",
        "symfony/flex": "^1.22",
        "symfony/form": "*",
        "symfony/framework-bundle": "*",
        "symfony/http-foundation": "*",
        "symfony/http-kernel": "*",
        "symfony/intl": "*",
        "symfony/mailer": "*",
        "symfony/monolog-bridge": "*",
        "symfony/monolog-bundle": "^3.6",
        "symfony/options-resolver": "*",
        "symfony/property-access": "*",
        "symfony/routing": "*",
        "symfony/runtime": "6.4.*",
        "symfony/security-bundle": "*",
        "symfony/serializer": "*",
        "symfony/twig-bridge": "*",
        "symfony/twig-bundle": "*",
        "symfony/validator": "*",
        "symfony/var-dumper": "*",
        "symfony/yaml": "*",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nikic/php-parser": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.6",
        "symfony/browser-kit": "*",
        "symfony/debug-bundle": "*",
        "symfony/process": "*",
        "symfony/stopwatch": "*",
        "symfony/web-profiler-bundle": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR% --symlink --relative": "symfony-cmd",
            "ln -sfn ../../src/Resources/public public/bundles/app": "script",
            "app:assets": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.26"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    }
}
