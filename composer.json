{
  "name": "sydtrack/ringsdb",
  "description": "The Lord of the Rings LCG deckbuilder",
  "license": "proprietary",
  "type": "project",
  "autoload": {
    "psr-4": {
      "": "src/",
      "SymfonyStandard\\": "app/"
    }
  },
  "require": {
    "php": ">=7.1.33",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-libxml": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "symfony/symfony": "^3.4",
    "symfony/assetic-bundle": "^2.8",
    "symfony/swiftmailer-bundle": "~2.3",
    "symfony/monolog-bundle": "^3.6",
    "sensio/framework-extra-bundle": "~3.0,>=3.0.2",
    "incenteev/composer-parameter-handler": "~2.0",
    "friendsofsymfony/user-bundle": "^2.1.0",
    "gedmo/doctrine-extensions": "^2.4",
    "doctrine/dbal": "^2.5",
    "doctrine/orm": "^2.5",
    "doctrine/doctrine-bundle": "^1.12",
    "friendsofsymfony/jsrouting-bundle": "^1.5",
    "ezyang/htmlpurifier": "^4.6",
    "leafo/scssphp": "^0.2.0",
    "patchwork/jsqueeze": "~1.0",
    "nelmio/api-doc-bundle": "^2.9",
    "erusev/parsedown": "^1.6",
    "symfony/twig-bundle": "^3.4",
    "symfony/asset": "^3.4",
    "phpoffice/phpspreadsheet": "^1.30.7",
    "doctrine/doctrine-migrations-bundle": "~2.2.0",
    "doctrine/migrations": "~2.2.0",
    "ocramius/proxy-manager": "~2.2.0"
  },
  "require-dev": {
    "sensio/generator-bundle": "~3.0",
    "symfony/phpunit-bridge": "4.4",
    "doctrine/doctrine-fixtures-bundle": "^2.4.1",
    "phpstan/phpstan": "^2.2"
  },
  "scripts": {
    "symfony-scripts": [
      "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
      "php app/console cache:clear --no-warmup",
      "php app/console assets:install web --symlink --relative",
      "php app/console assetic:dump"
    ],
    "post-install-cmd": [
      "@symfony-scripts"
    ],
    "post-update-cmd": [
      "@symfony-scripts"
    ]
  },
  "config": {
    "bin-dir": "bin"
  },
  "extra": {
    "symfony-app-dir": "app",
    "symfony-web-dir": "web",
    "symfony-assets-install": "relative",
    "incenteev-parameters": {
      "file": "app/config/parameters.yml"
    }
  }
}
