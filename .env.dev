# The values of the dev environment: the local Docker stack (docker-compose.yaml). Committed:
# local credentials only. Loaded after .env and .env.local, so it overrides them: to change one
# of these values on a machine, use .env.dev.local (not committed).

# Database
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=ringsdb
DATABASE_USER=symfony
DATABASE_PASSWORD=passwd

# Mailer
MAILER_TRANSPORT=smtp
MAILER_ENCRYPTION=ssl
MAILER_AUTH_MODE=login
MAILER_HOST=127.0.0.1
MAILER_USER=
MAILER_PASSWORD=

SECRET=ThisTokenIsNotSoSecretChangeIt

CACHE_EXPIRATION=600

# Email sender
EMAIL_SENDER_ADDRESS=noreply@ringsdb.test
EMAIL_SENDER_NAME=RingsDB

# Branding
GAME_NAME="LotR LCG"
PUBLISHER_NAME=FFG

DRAGNCARDS_ROOM=ringsdb

NOINDEX=false
