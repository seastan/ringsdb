{% extends 'layout.html.twig' %}
{% import "macros.html.twig" as macros %}

{% block body %}
    <div class="main white container">
        <div class="row">
            <div class="col-xs-6">
                <h1>Deck #{{ deck1.id }}</h1>
                <h3>{{ deck1.name }}</h3>
            </div>
            <div class="col-xs-6">
                <h1>Deck #{{ deck2.id }}</h1>
                <h3>{{ deck2.name }}</h3>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <h4>Heroes</h4>
            </div>
        </div>

        <!--  hero decks intersection -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in hero_deck.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in hero_deck.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>

        <!--  hero decks differences -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in hero_deck.differences[0] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in hero_deck.differences[1] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <h4>Draw Decks</h4>
            </div>
        </div>

        <!--  draw decks intersection -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in draw_deck.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in draw_deck.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>

        <!--  draw decks differences -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in draw_deck.differences[0] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in draw_deck.differences[1] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <h4>Sideboard</h4>
            </div>
        </div>

        <!--  sideboard intersection -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in sideboard.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in sideboard.common %}
                    <div>{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>

        <!--  sideboard differences -->
        <div class="row">
            <div class="col-xs-6">
                {% for slot in sideboard.differences[0] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
            <div class="col-xs-6">
                {% for slot in sideboard.differences[1] %}
                    <div class="diff">{{ macros.slot_with_icons(slot) }}</div>
                {% endfor %}
            </div>
        </div>
    </div>

{% endblock %}
