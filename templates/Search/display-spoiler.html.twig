{% extends 'Search/display.html.twig' %}

{% block main %}

{% for row in 0..(cards|length-1)//3 %}
	<div class="row">
		{% for col in 0..2 %}
			{% if row * 3 + col < cards|length %}
				{% set card = cards[row * 3 + col] %}
				<div class="col-sm-4 icon-bg icon-{{ card.sphere_code }} display-spoiler-card">
					<h4>{% include 'Search/card-name.html.twig' %}</h4>
					<div class="card-content">
						{% include 'Search/card-info.html.twig' %}
						{% include 'Search/card-text.html.twig' %}
						{% include 'Search/card-flavor.html.twig' %}
						{% include 'Search/card-illustrator.html.twig' %}
						{% include 'Search/card-pack-sphere.html.twig' %}
					</div>
				</div>
			{% endif %}
		{% endfor %}
	</div>
{% endfor %}

{% endblock %}
