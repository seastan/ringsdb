<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/6.5/phpunit.xsd"
         bootstrap="phpunit.bootstrap.php"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTodoAnnotatedTests="true"
         stopOnError="true"
         stopOnFailure="true"
         verbose="true">
    <testsuites>
        <testsuite name="default">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="SYMFONY_PHPUNIT_VERSION" value="6.5"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    </php>
    <logging>
        <log type="junit" target="var/log/phpunit.xml"/>
    </logging>
    <!-- Code coverage: lines executed by the tests are detected automatically (no @covers
         annotations). Files never executed are listed at 0% without being loaded. -->
    <filter>
        <whitelist addUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">src</directory>
            <exclude>
                <directory>src/DataFixtures</directory>
                <directory>src/PHPStan</directory>
            </exclude>
        </whitelist>
    </filter>
</phpunit>
