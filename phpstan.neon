parameters:
    level: 8
    paths:
        - src
    ignoreErrors:
        # phpstan-doctrine: columns nullable in the database but typed non-null in the entities
        # (docblocks); making them nullable spreads to every caller of their getters. To fix with
        # the typed properties, see MIGRATION.md
        - identifier: doctrine.columnType
    # phpstan/phpstan-symfony: the service types, read from the container dumped in debug mode
    # (make phpstan warms up the test cache first)
    symfony:
        containerXmlPath: var/cache/test/appTestDebugProjectContainer.xml
        consoleApplicationLoader: src/AppBundle/PHPStan/console-application.php
    # phpstan/phpstan-doctrine: the entity metadata (YAML mappings), for the repositories, the
    # fields and the DQL
    doctrine:
        objectManagerLoader: src/AppBundle/PHPStan/object-manager.php

services:
    -
        class: AppBundle\PHPStan\DoctrineRegistryReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: AppBundle\PHPStan\ControllerGetUserReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
