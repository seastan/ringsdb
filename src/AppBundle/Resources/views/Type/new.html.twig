{% extends 'AppBundle:Admin:base.html.twig' %}

{% block content -%}
<h1>Type creation</h1>

    <form action="{{ path('admin_type_create') }}" method="post" {% if form.vars.multipart %}enctype="multipart/form-data"{% endif %}>
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-success">Create</button>
        <a href="{{ path('admin_type') }}" class="btn btn-default">
         	Back to the list
     	</a>
    </form>
{% endblock %}
