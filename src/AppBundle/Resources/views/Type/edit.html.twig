{% extends 'AppBundle:Admin:base.html.twig' %}

{% block content -%}
<h1>Type edit</h1>

    {{ form_start(edit_form, {'action': path('admin_type_update', { 'id': entity.id })}) }}
        {{ form_widget(edit_form) }}
            <button type="submit" class="btn btn-success">Edit</button>
    {{ form_end(edit_form) }}
    <br>
        <a href="{{ path('admin_type') }}" class="btn btn-default">
            Back to the list
        </a>
        {{ form_start(delete_form, {'action': path('admin_type_delete', { 'id': entity.id }), 'attr': {'style': 'display:inline-block'}}) }}
            {{ form_widget(delete_form) }}
            <button type="submit" class="btn btn-danger">Delete</button>
        {{ form_end(delete_form) }}
{% endblock %}
