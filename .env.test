# Fixed values for the tests (formerly config/parameters_test.yaml and the doctrine.dbal block of
# config_test.yml), loaded after .env in the test environment, whatever .env says: the test
# database, and the variables the tests depend on (the snapshots, the cache headers, the emails).

# the test database (the mysql_test service; make test-fixtures drops and rebuilds it)
DATABASE_HOST=mysql_test
DATABASE_PORT=3306
DATABASE_NAME=ringsdb_test
DATABASE_USER=symfony
DATABASE_PASSWORD=passwd

# the Cache-Control max-age of the public pages and API
CACHE_EXPIRATION=600

# the snapshots were recorded without branding: empty titles and texts
GAME_NAME=
PUBLISHER_NAME=

EMAIL_SENDER_ADDRESS=noreply@ringsdb.test
EMAIL_SENDER_NAME=RingsDB

DRAGNCARDS_ROOM=ringsdb
NOINDEX=false
